{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python: Current File (.venv)",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "python": "${workspaceFolder}/.venv/bin/python",
            "windows": {
                "python": "${workspaceFolder}/.venv/Scripts/python.exe"
            },
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "ASX EOD Downloader",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/asx_eod_downloader.py",
            "console": "integratedTerminal",
            "python": "${workspaceFolder}/.venv/bin/python",
            "windows": {
                "python": "${workspaceFolder}/.venv/Scripts/python.exe"
            },
            "cwd": "${workspaceFolder}"
        }
    ]
}
